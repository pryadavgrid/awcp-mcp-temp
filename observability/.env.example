# observability/.env.example — TEMPLATE for the IAM secrets file (committed).
#
# Setup:
#   cp observability/.env.example observability/.env
#   # then fill in strong values, e.g.:  openssl rand -hex 20
#
# observability/.env is gitignored and is the ONLY place real credentials live.
# docker compose loads it into the keycloak container; Keycloak substitutes the
# ${...} placeholders in keycloak/AWCP-realm.json at import time.

# --- Keycloak admin console (http://localhost:8083) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- awcp-agent service account (client-credentials; used by awcp_kit in Phase 6) ---
AWCP_AGENT_CLIENT_SECRET=change-me

# --- seeded test users (realm import) ---
OPERATOR_TEST_PASSWORD=change-me
VIEWER_TEST_PASSWORD=change-me

# --- Postgres (reuses the existing awcp-postgres container) ---
POSTGRES_USER=awcp
POSTGRES_PASSWORD=awcppassword
POSTGRES_DB=awcp

# --- Credential-application email approval ("Apply for credentials") ---
IAM_APPROVER_EMAIL=approver@example.com     # who receives + approves requests
IAM_ENC_KEY=                                 # `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
IAM_ALLOWED_ROLES=viewer,operator,auditor
IAM_PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=                                   # empty → email is logged, not sent
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=awcp@localhost
IAM_KC_ADMIN_USER=                           # defaults to KC_BOOTSTRAP_ADMIN_USERNAME
IAM_KC_ADMIN_PASSWORD=
